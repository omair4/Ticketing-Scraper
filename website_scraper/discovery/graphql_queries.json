{
  "requests": [
    {
      "operationName": "PublicProEvents",
      "query": "query PublicProEvents($take: Int! = 10, $skip: Int! = 0, $search: String, $city: String, $sellerId: String, $venueId: [ObjectID!], $location: GeolocationPoints, $distance: Int!, $carousel: Boolean, $featured: Boolean, $includedGenres: [String!], $excludedGenres: [String!], $startDateRange: DateRangeInput, $artistId: ObjectID, $excludeStatus: [ProEventStatus!]) {\n  publicProEvents(\n    take: $take\n    skip: $skip\n    search: $search\n    city: $city\n    sellerId: $sellerId\n    venueId: $venueId\n    location: $location\n    distance: $distance\n    carousel: $carousel\n    featured: $featured\n    includedGenres: $includedGenres\n    excludedGenres: $excludedGenres\n    startDateRange: $startDateRange\n    artistId: $artistId\n    excludeStatus: $excludeStatus\n  ) {\n    items {\n      category\n      id\n      title\n      admitoneTitle\n      description\n      showclixId\n      ageLimit\n      ageLimitValue\n      clientEventUrl\n      venue {\n        id\n        name\n        city\n        accessibilityDetails\n        __typename\n      }\n      sellerId\n      admitoneTitle\n      shortName\n      imageUrl\n      status\n      hidden\n      hiddenUntil\n      featured\n      carousel\n      carouselLinkTo\n      salesOpen\n      eventDoorTime\n      eventStart\n      eventEnd\n      eventTimeStart\n      eventTimeEnd\n      redirect\n      provider\n      tourName\n      layaway\n      fbPixelId\n      tiktokPixelId\n      twitterPixelId\n      snapchatPixelId\n      pinterestPixelId\n      soldOut\n      searchableTags\n      promotions {\n        onSale\n        discount\n        promoCode\n        discountUntil\n        discountStart\n        __typename\n      }\n      bannerTall\n      ticketRange\n      ticketRangeIncludesFees\n      waitlistUrl\n      accessibilityDetails\n      promoters {\n        promoterName\n        promoterLink\n        __typename\n      }\n      frontEndGenres\n      internalGenres\n      artistIds\n      secondaryArtistIds\n      timezone\n      createdAt\n      updatedAt\n      resaleEventId\n      artists {\n        id\n        title\n        slug\n        __typename\n      }\n      secondaryArtists {\n        id\n        title\n        slug\n        __typename\n      }\n      __typename\n    }\n    total\n    skip\n    take\n    __typename\n  }\n}",
      "variables": {
        "take": 4,
        "skip": 0,
        "location": {
          "latitude": 43.6532,
          "longitude": -79.3832
        },
        "distance": 75,
