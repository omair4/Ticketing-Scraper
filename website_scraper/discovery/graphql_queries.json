    {
      "operationName": "OrganizerEvents",
      "query": "query OrganizerEvents($organizerId: String!, $current: Boolean! = true, $take: Int! = 10, $skip: Int! = 0, $orderBy: BsonSortInput, $startDateRange: DateRangeInput) {\n  organizerEvents(\n    organizerId: $organizerId\n    current: $current\n    take: $take\n    skip: $skip\n    orderBy: $orderBy\n    startDateRange: $startDateRange\n  ) {\n    items {\n      id\n      status\n      address {\n        formattedAddress\n        businessName\n        __typename\n      }\n      place\n      url\n      endDate\n      eventImage\n      embeddedImages\n      videoEmbedUrl\n      feesRange {\n        hasLockedCategoryWithInventory\n        soldOut\n        min\n        max\n        __typename\n      }\n      ticketCategories(donationsFilter: with) {\n        status\n        quantityDistributed\n        quantityIssued\n        quantityLimit\n        visibility\n        codeToUnlock\n        flexiblePricing {\n          isDonation\n          __typename\n        }\n        __typename\n      }\n      startDate\n      timezone\n      title\n      category\n      description\n      presentedByName\n      eventTags\n      organizerType\n      organizerColor\n      organizerId\n      eventOrganizerDisplayName\n      shortEventId\n      ga4\n      fbpid\n      ttpid\n      twpid\n      scpid\n      ldpid\n      spid\n      eventCapacity\n      visibility\n      seriesParentEventId\n      waitlistEnabled\n      recurringEvents {\n        id\n        title\n        startDate\n        endDate\n        shortEventId\n        __typename\n      }\n      suspension {\n        indefinite\n        __typename\n      }\n      overrideDateRange\n      overridePriceRange\n      __typename\n    }\n    total\n    skip\n    __typename\n  }\n}",
      "variables": {
        "current": true,
        "take": 3,
        "skip": 0,
